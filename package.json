{
  "name": "brote",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma educativa con guía de IA, captura de apuntes y presencia por QR (Groq + Firebase + Netlify).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "build": "npm run build:css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "dev": "npm run build:css && netlify dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.8",
    "@netlify/database": "^2.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "firebase-admin": "^12.6.0",
    "jose": "^6.2.16",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-beta.22",
    "netlify-cli": "^17.0.0",
    "tailwindcss": "^3.4.13"
  }
}
